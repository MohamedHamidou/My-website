# Normalize line endings to LF everywhere.
#
# The deployment scripts under deploy/ are executed by bash on the Ubuntu
# laptop. With core.autocrlf=true (the Windows default) they would be checked
# out with CRLF and fail with "\r: command not found".
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.service text eol=lf
deploy/deploy-site text eol=lf
deploy/site-url text eol=lf
*.pdf binary
