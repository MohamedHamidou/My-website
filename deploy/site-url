#!/usr/bin/env bash
#
# site-url - print the current public URL of the site.
#
# The Cloudflare quick tunnel generates a random hostname each time it starts,
# so this reads the live URL out of the tunnel log.
#
set -euo pipefail

LOG=/var/log/cloudflared.log
PATTERN='https://[a-z0-9-]+\.trycloudflare\.com'

url=""
if [[ -r "$LOG" ]]; then
  url=$(grep -oE "$PATTERN" "$LOG" 2>/dev/null | tail -n1 || true)
fi

if [[ -z "$url" ]]; then
  url=$(journalctl -u site-tunnel --no-pager -n 300 2>/dev/null | grep -oE "$PATTERN" | tail -n1 || true)
fi

if [[ -z "$url" ]]; then
  echo "site-url: no tunnel URL found yet - check 'systemctl status site-tunnel'" >&2
  exit 1
fi

echo "$url"
